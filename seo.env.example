# Add these to .env.local and to the hosting provider's production build environment.
# The owner-confirmed domain below is also the source default.
# Override only when moving to another public HTTPS origin, with no path.
SITE_URL=https://www.urmichakraborty.com

# Force noindex for staging/non-Vercel preview deployments; leave false on production.
# Vercel preview/development builds are automatically noindex.
SITE_NOINDEX=false

# Optional Search Console HTML verification token (token only).
GOOGLE_SITE_VERIFICATION=

# Optional GA4 destination. Analytics loads only on configured indexable builds.
# No tag, cookies or analytics network requests are added while this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
